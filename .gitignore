# Build output
build/bin/
build/windows/installer/wails_tools.nsh
frontend/dist/

# frontend/wailsjs is generated by `wails build`, but it is committed so that
# `tsc --noEmit` works on a fresh clone without running a full build first.

# Dependencies
node_modules/

# Scratch space: screenshots, export samples, throwaway scripts
tmp/
output/

# Disposable fixture vault and AppData root used by UI verification
.tmp-ui-*/

# Agent / debug dumps
debug-*.log
*.log

# Editor and OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
